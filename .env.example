# Gemini API Key cho Translation và Gemini TTS (nếu dùng)
GEMINI_API_KEY=your_gemini_api_key_here

# Cấu hình Host & Port
HOST=127.0.0.1
PORT=8000

# Cấu hình Upload Limit (Bytes) - 500MB = 524288000
MAX_UPLOAD_SIZE_BYTES=524288000

# Whisper Default Model: tiny, base, small, medium, large-v3
WHISPER_DEFAULT_MODEL=small
